<Window x:Class="AshkeGhalam.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حسابداری اشک قلم — نسخه بومی ویندوز"
        Width="1360" Height="880" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHint">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="NavButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#172033"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#26364E"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#0F766E"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavSectionLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="7,15,7,5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0F172A" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="اشک قلم" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="CurrentModuleText" Text="پیشخوان • نسخهٔ بومی در کنار نسخهٔ اصلی" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="18" Padding="12,7">
                    <TextBlock x:Name="StorageStatus" Text="در حال بارگذاری..." Foreground="#E2E8F0" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
                <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="282"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TabControl x:Name="MainTabs" Margin="0,0,14,0" Padding="0" SelectionChanged="MainTabs_SelectionChanged">
                    <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ControlTemplate>
                    </TabControl.Template>
            <TabItem Header="نمای کلی">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="نمای کلی کسب‌وکار" FontSize="25" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="خلاصه از اطلاعات ذخیره‌شده در همین رایانه" Style="{StaticResource SectionHint}"/>
                        <UniformGrid Columns="4" Margin="0,18,0,12">
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel><TextBlock Text="مشتریان" Foreground="#64748B"/><TextBlock x:Name="CustomerCount" Text="۰" FontSize="26" FontWeight="Bold" Foreground="#0F766E" Margin="0,10,0,0"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel><TextBlock Text="کالاها" Foreground="#64748B"/><TextBlock x:Name="ProductCount" Text="۰" FontSize="26" FontWeight="Bold" Foreground="#0F766E" Margin="0,10,0,0"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel><TextBlock Text="فاکتورهای صادرشده" Foreground="#64748B"/><TextBlock x:Name="InvoiceCount" Text="۰" FontSize="26" FontWeight="Bold" Foreground="#0F766E" Margin="0,10,0,0"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel><TextBlock Text="ارزش فروش" Foreground="#64748B"/><TextBlock x:Name="SalesTotal" Text="۰" FontSize="22" FontWeight="Bold" Foreground="#0F766E" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="وضعیت مالی" FontSize="18" FontWeight="Bold"/>
                                <UniformGrid Columns="3" Margin="0,14,0,0">
                                    <StackPanel><TextBlock Text="دریافت ثبت‌شده" Foreground="#64748B"/><TextBlock x:Name="PaymentsTotal" Text="۰" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="مانده فاکتورها" Foreground="#64748B"/><TextBlock x:Name="ReceivablesTotal" Text="۰" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="هزینه‌ها" Foreground="#64748B"/><TextBlock x:Name="ExpensesTotal" Text="۰" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="آخرین فاکتورها" FontSize="18" FontWeight="Bold" Margin="0,20,0,0"/>
                        <DataGrid x:Name="RecentInvoicesGrid" Height="235">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="شماره" Binding="{Binding Number}" Width="80"/>
                                <DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                                <DataGridTextColumn Header="مبلغ کل" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="150"/>
                                <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="مشتریان">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="مدیریت مشتریان" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="اطلاعات مشتری در حافظه محلی این رایانه ذخیره می‌شود." Style="{StaticResource SectionHint}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="ثبت مشتری جدید" Click="AddCustomer_Click" Background="#0F766E" Foreground="White"/>
                            <Button Content="ویرایش مشتری انتخابی" Click="EditCustomer_Click"/>
                            <Button Content="حذف مشتری انتخابی" Click="DeleteCustomer_Click"/>
                            <Button Content="خروجی CSV" Click="ExportCustomers_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="CustomersGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام / شرکت" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="تلفن" Binding="{Binding Phone}" Width="170"/>
                            <DataGridTextColumn Header="نشانی" Binding="{Binding Address}" Width="2*"/>
                            <DataGridTextColumn Header="تاریخ ثبت" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="کالا و انبار">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="کالا و انبار" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="صدور فاکتور، موجودی قابل دسترس را به‌صورت محلی کاهش می‌دهد." Style="{StaticResource SectionHint}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="ثبت کالا" Click="AddProduct_Click" Background="#0F766E" Foreground="White"/>
                            <Button Content="ویرایش کالای انتخابی" Click="EditProduct_Click"/>
                            <Button Content="حذف کالای انتخابی" Click="DeleteProduct_Click"/>
                            <Button Content="ورود موجودی" Click="AddStock_Click"/>
                            <Button Content="خروجی CSV" Click="ExportProducts_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="ProductsGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام کالا" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="کد کالا" Binding="{Binding Sku}" Width="150"/>
                            <DataGridTextColumn Header="واحد" Binding="{Binding Unit}" Width="90"/>
                            <DataGridTextColumn Header="موجودی" Binding="{Binding StockQuantity, StringFormat={}{0:N2}}" Width="130"/>
                            <DataGridTextColumn Header="قیمت واحد" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="فاکتورها">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="فاکتورهای فروش" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="مبالغ با نوع decimal محاسبه و پیش از ثبت اعتبارسنجی می‌شوند. نرخ مالیات را فقط مطابق وضعیت قانونی خود وارد کنید." Style="{StaticResource SectionHint}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="صدور فاکتور" Click="AddInvoice_Click" Background="#0F766E" Foreground="White"/>
                            <Button Content="ثبت دریافت" Click="AddPayment_Click"/>
                            <Button Content="لغو فاکتور انتخابی" Click="CancelInvoice_Click"/>
                            <Button Content="چاپ فاکتور انتخابی" Click="PrintInvoice_Click"/>
                            <Button Content="خروجی CSV" Click="ExportInvoices_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="InvoicesGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره" Binding="{Binding Number}" Width="80"/>
                            <DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="جمع" Binding="{Binding Subtotal, StringFormat={}{0:N2}}" Width="135"/>
                            <DataGridTextColumn Header="مالیات" Binding="{Binding TaxAmount, StringFormat={}{0:N2}}" Width="125"/>
                            <DataGridTextColumn Header="مبلغ کل" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="150"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="دریافت‌ها">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="دریافت از مشتریان" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="ثبت دریافت فقط تا سقف ماندهٔ فاکتور انتخابی مجاز است." Style="{StaticResource SectionHint}"/>
                        <Button Content="ثبت دریافت جدید" Click="AddPayment_Click" HorizontalAlignment="Right" Margin="0,14,0,0" Background="#0F766E" Foreground="White"/>
                    </StackPanel>
                    <DataGrid x:Name="PaymentsGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره فاکتور" Binding="{Binding InvoiceNumber}" Width="120"/>
                            <DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="مبلغ دریافتی" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="170"/>
                            <DataGridTextColumn Header="روش" Binding="{Binding Method}" Width="130"/>
                            <DataGridTextColumn Header="پیگیری" Binding="{Binding Reference}" Width="*"/>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="هزینه‌ها">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="هزینه‌های ثبت‌شده" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="این ثبت هزینه‌ها، گردش نقدی ساده است و جایگزین دفتر کل و کدینگ حسابداری رسمی نیست." Style="{StaticResource SectionHint}"/>
                        <Button Content="ثبت هزینه" Click="AddExpense_Click" HorizontalAlignment="Right" Margin="0,14,0,0" Background="#0F766E" Foreground="White"/>
                    </StackPanel>
                    <DataGrid x:Name="ExpensesGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="دسته‌بندی" Binding="{Binding Category}" Width="180"/>
                            <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="170"/>
                            <DataGridTextColumn Header="توضیحات" Binding="{Binding Notes}" Width="*"/>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="گزارش‌ها">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="گزارش خلاصه" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="گزارش‌ها از داده‌های محلی ثبت‌شده ساخته می‌شوند؛ واحد پول ورودی را در همهٔ رکوردها یکسان نگه دارید." Style="{StaticResource SectionHint}"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="فروش خالص (بدون فاکتورهای لغوشده)" FontSize="14" Foreground="#64748B"/>
                                <TextBlock x:Name="ReportSales" Text="۰" FontSize="28" FontWeight="Bold" Foreground="#0F766E" Margin="0,6,0,16"/>
                                <TextBlock Text="دریافت‌ها" FontSize="13" Foreground="#64748B"/>
                                <TextBlock x:Name="ReportPayments" Text="۰" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,16"/>
                                <TextBlock Text="مانده مطالبات" FontSize="13" Foreground="#64748B"/>
                                <TextBlock x:Name="ReportReceivables" Text="۰" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,16"/>
                                <TextBlock Text="هزینه‌ها" FontSize="13" Foreground="#64748B"/>
                                <TextBlock x:Name="ReportExpenses" Text="۰" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,16"/>
                                <TextBlock Text="خالص جریان نقدی ساده = دریافت‌ها منهای هزینه‌ها" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="ReportCash" Text="۰" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Content="خروجی خلاصه گزارش CSV" Click="ExportReport_Click" HorizontalAlignment="Right" Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="پشتیبان‌گیری">
                <StackPanel Margin="18" MaxWidth="850" HorizontalAlignment="Right">
                    <TextBlock Text="پشتیبان‌گیری و بازیابی" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="فایل پشتیبان با رمز جداگانه AES-256-GCM رمزگذاری می‌شود. رمز را در جای امن نگه دارید؛ بدون آن بازیابی امکان‌پذیر نیست."
                               TextWrapping="Wrap" FontSize="13" Foreground="#64748B" Margin="0,8,0,20"/>
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="ایجاد پشتیبان رمزگذاری‌شده" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="مناسب انتقال امن فایل داده به مسیر انتخابی شما. نسخهٔ جاری پایگاه دادهٔ ابری را شامل نمی‌شود."
                                       TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,5,0,12"/>
                            <Button Content="ایجاد فایل پشتیبان..." Click="CreateBackup_Click" HorizontalAlignment="Right" Background="#0F766E" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="بازیابی از پشتیبان" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="قبل از جایگزینی اطلاعات فعلی، فایل انتخابی و رمز آن بررسی می‌شود. پس از موفقیت، داده‌های فعلی با محتوای پشتیبان جایگزین می‌شوند."
                                       TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,5,0,12"/>
                            <Button Content="انتخاب فایل و بازیابی..." Click="RestoreBackup_Click" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="محل دادهٔ محلی: %LOCALAPPDATA%\AshkeGhalam\WindowsNative\accounting-data.dat"
                               TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,18,0,0"/>
                </StackPanel>
            </TabItem>
                </TabControl>
                <Border x:Name="MigrationPanel" Visibility="Collapsed" Background="#F1F5F9" CornerRadius="14" Padding="28">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel VerticalAlignment="Top" MaxWidth="850" HorizontalAlignment="Right">
                            <TextBlock Text="مهاجرت نسخهٔ بومی اشک قلم" FontSize="12" FontWeight="Bold" Foreground="#0F766E"/>
                            <TextBlock x:Name="MigrationPageTitle" Text="ماژول" FontSize="30" FontWeight="Bold" Foreground="#0F172A" Margin="0,12,0,0"/>
                            <TextBlock x:Name="MigrationPageGroup" Text="گروه و مسیر" FontSize="12" Foreground="#64748B" Margin="0,8,0,20" TextWrapping="Wrap"/>
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="این بخش در نسخهٔ اصلی اشک قلم موجود است." FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="قرار است منطق، اطلاعات، فرم‌ها، قواعد و ارتباطات همین بخش به کد بومی C# و WPF منتقل شود؛ این پنجره فعلاً صفحهٔ عملیاتی جعلی جایگزین آن نمی‌سازد." TextWrapping="Wrap" FontSize="13" Foreground="#475569" Margin="0,8,0,0"/>
                                    <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="MigrationPageState" Text="وضعیت: هنوز پیاده‌سازی و با نسخهٔ اصلی آزمون تطبیقی نشده است." FontWeight="Bold" Foreground="#9A3412" TextWrapping="Wrap"/>
                                            <TextBlock Text="تا زمان تکمیل و آزمون، برای این عملیات از نسخهٔ اصلی قبلی استفاده کنید. این نسخه به‌صورت مستقل و در کنار آن توسعه می‌یابد." Foreground="#7C2D12" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="بازگشت به پیشخوان بومی" Click="ReturnToDashboard_Click" HorizontalAlignment="Right" Margin="0,18,0,0" Background="#0F766E" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border Grid.Column="1" Background="#0F172A" CornerRadius="15" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavigationRoot">
                        <Border Background="#111F35" CornerRadius="12" Padding="13" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="اشک قلم" Foreground="#F8FAFC" FontSize="21" FontWeight="Bold"/>
                                <TextBlock Text="نسخهٔ بومی ویندوز" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Text="مهاجرت مستقل از نسخهٔ اصلی" Foreground="#94A3B8" FontSize="10" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
