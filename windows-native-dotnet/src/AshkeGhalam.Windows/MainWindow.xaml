<Window x:Class="AshkeGhalam.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حسابداری اشک قلم — نسخه بومی ویندوز"
        Width="1360" Height="880" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        FlowDirection="RightToLeft" FontFamily="Vazirmatn, Tahoma, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/> 
            <Setter Property="FontFamily" Value="Vazirmatn, Tahoma, Segoe UI"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Vazirmatn, Tahoma, Segoe UI"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Vazirmatn, Tahoma, Segoe UI"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHint">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="NavButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#172033"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#26364E"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#0F766E"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavSectionLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="7,15,7,5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0F172A" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="اشک قلم" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="CurrentModuleText" Text="پیشخوان • نسخهٔ بومی در کنار نسخهٔ اصلی" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="18" Padding="12,7">
                    <TextBlock x:Name="StorageStatus" Text="در حال بارگذاری..." Foreground="#E2E8F0" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" FlowDirection="RightToLeft">
                <TabControl x:Name="MainTabs" FlowDirection="RightToLeft" Margin="0,0,14,0" Padding="0" SelectionChanged="MainTabs_SelectionChanged">
                    <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ControlTemplate>
                    </TabControl.Template>
            <TabItem Header="نمای کلی">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="نمای کلی کسب‌وکار" FontSize="25" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="خلاصه از اطلاعات ذخیره‌شده در همین رایانه" Style="{StaticResource SectionHint}"/>
                        <UniformGrid Columns="5" Margin="0,18,0,12">
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel><TextBlock Text="مشتریان" Foreground="#64748B"/><TextBlock x:Name="CustomerCount" Text="۰" FontSize="26" FontWeight="Bold" Foreground="#0F766E" Margin="0,10,0,0"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel><TextBlock Text="کالاها" Foreground="#64748B"/><TextBlock x:Name="ProductCount" Text="۰" FontSize="26" FontWeight="Bold" Foreground="#0F766E" Margin="0,10,0,0"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel><TextBlock Text="اسناد صادرشده" Foreground="#64748B"/><TextBlock x:Name="InvoiceCount" Text="۰" FontSize="26" FontWeight="Bold" Foreground="#0F766E" Margin="0,10,0,0"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel><TextBlock Text="ارزش فروش" Foreground="#64748B"/><TextBlock x:Name="SalesTotal" Text="۰" FontSize="22" FontWeight="Bold" Foreground="#0F766E" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel><TextBlock Text="ارزش خرید" Foreground="#64748B"/><TextBlock x:Name="PurchasesTotal" Text="۰" FontSize="22" FontWeight="Bold" Foreground="#0F766E" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="وضعیت مالی" FontSize="18" FontWeight="Bold"/>
                                <UniformGrid Columns="4" Margin="0,14,0,0">
                                    <StackPanel><TextBlock Text="دریافت ثبت‌شده" Foreground="#64748B"/><TextBlock x:Name="PaymentsTotal" Text="۰" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="مطالبات فروش" Foreground="#64748B"/><TextBlock x:Name="ReceivablesTotal" Text="۰" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="پرداختنی خرید" Foreground="#64748B"/><TextBlock x:Name="PayablesTotal" Text="۰" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="هزینه‌ها" Foreground="#64748B"/><TextBlock x:Name="ExpensesTotal" Text="۰" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="عملیات سریع" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="ثبت اطلاعات پایه و انجام کارهای پرتکرار، بدون جست‌وجو در منوها" Style="{StaticResource SectionHint}" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="＋ ثبت سریع شخص / مشتری" Click="AddCustomer_Click" Background="#0F766E" Foreground="White" Margin="0,0,8,8"/>
                                    <Button Content="＋ ثبت تأمین‌کننده" Click="AddSupplier_Click" Margin="0,0,8,8"/>
                                    <Button Content="＋ ثبت سریع کالا" Click="AddProduct_Click" Background="#0F766E" Foreground="White" Margin="0,0,8,8"/>
                                    <Button Content="＋ فاکتور جدید" Click="AddInvoice_Click" Background="#0F766E" Foreground="White" Margin="0,0,8,8"/>
                                    <Button Content="ثبت دریافت از مشتری" Click="AddReceipt_Click" Margin="0,0,8,8"/>
                                    <Button Content="پرداخت به تأمین‌کننده" Click="AddSupplierPayment_Click" Margin="0,0,8,8"/>
                                    <Button Content="ثبت دریافت / پرداخت (همه)" Click="AddPayment_Click" Margin="0,0,8,8"/>
                                    <Button Content="ثبت هزینه" Click="AddExpense_Click" Margin="0,0,8,8"/>
                                    <Button Content="ورود موجودی" Click="AddStock_Click" Margin="0,0,8,8"/>
                                    <Button Content="حواله انبار" Click="AddVoucher_Click" Margin="0,0,8,8"/>
                                    <Button Content="پیش‌نمایش فاکتور انتخابی" Click="PreviewInvoice_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="آخرین اسناد" FontSize="18" FontWeight="Bold" Margin="0,20,0,0"/>
                        <DataGrid x:Name="RecentInvoicesGrid" Height="235">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="نوع" Binding="{Binding TypeLabel}" Width="105"/>
                                <DataGridTextColumn Header="شماره سند" Binding="{Binding DisplayNumber}" Width="120"/>
                                <DataGridTextColumn Header="طرف حساب" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                                <DataGridTextColumn Header="مبلغ کل" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="150"/>
                                <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="مشتریان">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="مدیریت اشخاص" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="مدل پرونده از نسخهٔ اصلی توسعه یافته است: کد، نقش مشتری/تأمین‌کننده، دسته‌بندی، اطلاعات تماس و یادداشت. ماندهٔ حساب هنوز با انتقال دفترکل اصلی محاسبه نمی‌شود." Style="{StaticResource SectionHint}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,14,0,0">
                            <TextBox x:Name="CustomersSearchBox" Tag="customers" Width="225" Height="34" Padding="8,4" ToolTip="جست‌وجو در کد، نام، تلفن، ایمیل و نشانی" TextChanged="GridSearch_TextChanged" Margin="0,0,8,8"/>
                            <ComboBox x:Name="CustomersPageSize" Tag="customers" Width="118" Height="34" SelectedIndex="0" SelectionChanged="GridPageSize_SelectionChanged" Margin="0,0,8,8">
                                <ComboBoxItem Content="۱۰۰ ردیف" Tag="100"/><ComboBoxItem Content="۲۵۰ ردیف" Tag="250"/><ComboBoxItem Content="۵۰۰ ردیف" Tag="500"/>
                            </ComboBox>
                            <Button x:Name="CustomersPreviousPage" Tag="customers" Content="قبلی" Click="GridPreviousPage_Click" IsEnabled="False" Margin="0,0,4,8"/>
                            <TextBlock x:Name="CustomersPageInfo" Text="صفحه ۱ از ۱" VerticalAlignment="Center" Margin="4,0,8,8"/>
                            <Button x:Name="CustomersNextPage" Tag="customers" Content="بعدی" Click="GridNextPage_Click" IsEnabled="False" Margin="0,0,12,8"/>
                            <Button Content="ثبت شخص جدید" Click="AddCustomer_Click" Background="#0F766E" Foreground="White" Margin="0,0,8,8"/>
                            <Button Content="ثبت تأمین‌کننده" Click="AddSupplier_Click" Margin="0,0,8,8"/>
                            <Button Content="ویرایش شخص انتخابی" Click="EditCustomer_Click" Margin="0,0,8,8"/>
                            <Button Content="حذف شخص انتخابی" Click="DeleteCustomer_Click" Margin="0,0,8,8"/>
                            <Button Content="خروجی CSV کامل پرونده‌ها" Click="ExportCustomers_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="CustomersGrid" Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کد شخص" Binding="{Binding Code}" Width="105"/>
                            <DataGridTextColumn Header="نام / شرکت" Binding="{Binding Name}" Width="210"/>
                            <DataGridTextColumn Header="نقش" Binding="{Binding RoleLabel}" Width="155"/>
                            <DataGridTextColumn Header="دسته‌بندی" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="تلفن" Binding="{Binding Phone}" Width="135"/>
                            <DataGridTextColumn Header="ایمیل" Binding="{Binding Email}" Width="190"/>
                            <DataGridTextColumn Header="شناسه ملی" Binding="{Binding NationalId}" Width="130"/>
                            <DataGridTextColumn Header="نشانی" Binding="{Binding Address}" Width="250"/>
                            <DataGridTextColumn Header="یادداشت" Binding="{Binding Notes}" Width="220"/>
                            <DataGridTextColumn Header="ماندهٔ ذخیره‌شده*" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="145"/>
                            <DataGridTextColumn Header="تاریخ ثبت" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="155"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="کالا و انبار">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="کالا و انبار" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="پرونده کالا با فیلدهای مدل اصلی گسترش یافته است؛ موجودی رزروشده حفظ می‌شود و گردش حواله‌های چندانباره هنوز در مرحلهٔ مهاجرت است." Style="{StaticResource SectionHint}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,14,0,0">
                            <TextBox x:Name="ProductsSearchBox" Tag="products" Width="225" Height="34" Padding="8,4" ToolTip="جست‌وجو در کد، نام، سریال، دسته‌بندی و قفسه" TextChanged="GridSearch_TextChanged" Margin="0,0,8,8"/>
                            <ComboBox x:Name="ProductsPageSize" Tag="products" Width="118" Height="34" SelectedIndex="0" SelectionChanged="GridPageSize_SelectionChanged" Margin="0,0,8,8">
                                <ComboBoxItem Content="۱۰۰ ردیف" Tag="100"/><ComboBoxItem Content="۲۵۰ ردیف" Tag="250"/><ComboBoxItem Content="۵۰۰ ردیف" Tag="500"/>
                            </ComboBox>
                            <Button x:Name="ProductsPreviousPage" Tag="products" Content="قبلی" Click="GridPreviousPage_Click" IsEnabled="False" Margin="0,0,4,8"/>
                            <TextBlock x:Name="ProductsPageInfo" Text="صفحه ۱ از ۱" VerticalAlignment="Center" Margin="4,0,8,8"/>
                            <Button x:Name="ProductsNextPage" Tag="products" Content="بعدی" Click="GridNextPage_Click" IsEnabled="False" Margin="0,0,12,8"/>
                            <Button Content="ثبت کالا" Click="AddProduct_Click" Background="#0F766E" Foreground="White" Margin="0,0,8,8"/>
                            <Button Content="ویرایش کالای انتخابی" Click="EditProduct_Click" Margin="0,0,8,8"/>
                            <Button Content="حذف کالای انتخابی" Click="DeleteProduct_Click" Margin="0,0,8,8"/>
                            <Button Content="کارتکس کالای انتخابی" Click="ShowKardex_Click" Margin="0,0,8,8"/>
                            <TextBox x:Name="ProductsBarcodeSearchBox" Width="185" Height="34" Padding="8,4" ToolTip="بارکد را اسکن کنید؛ سپس Enter بزنید" KeyDown="ProductsBarcodeSearchBox_KeyDown" Margin="0,0,8,8"/>
                            <Button Content="ورود موجودی" Click="AddStock_Click" Margin="0,0,8,8"/>
                            <Button Content="خروجی CSV" Click="ExportProducts_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="ProductsGrid" Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام کالا" Binding="{Binding Name}" Width="210"/>
                            <DataGridTextColumn Header="کد کالا" Binding="{Binding Code}" Width="120"/>
                            <DataGridTextColumn Header="شماره سریال" Binding="{Binding SerialNumber}" Width="140"/>
                            <DataGridTextColumn Header="واحد" Binding="{Binding Unit}" Width="90"/>
                            <DataGridTextColumn Header="دسته‌بندی" Binding="{Binding CategoryPath}" Width="190"/>
                            <DataGridTextColumn Header="موجودی" Binding="{Binding StockQuantity, StringFormat={}{0:N2}}" Width="120"/>
                            <DataGridTextColumn Header="رزروشده" Binding="{Binding ReservedStock, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="حداقل موجودی" Binding="{Binding MinStock, StringFormat={}{0:N2}}" Width="120"/>
                            <DataGridTextColumn Header="قیمت خرید" Binding="{Binding BuyPrice, StringFormat={}{0:N2}}" Width="130"/>
                            <DataGridTextColumn Header="قیمت فروش" Binding="{Binding SellPrice, StringFormat={}{0:N2}}" Width="130"/>
                            <DataGridTextColumn Header="وزن" Binding="{Binding Weight, StringFormat={}{0:N2}}" Width="90"/>
                            <DataGridTextColumn Header="قفسه" Binding="{Binding ShelfLocation}" Width="130"/>
                            <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" Width="220"/>
                            <DataGridTextColumn Header="تصویر / مسیر" Binding="{Binding ImageUrl}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="فاکتورهای فروش/خرید">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="فاکتور فروش، خرید و پیش‌فاکتور" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="هم‌ترازی با گردش اصلی: شماره‌گذاری مستقل INV-/PUR-/PRO-، تخفیف و مالیات مبلغی؛ فروش موجودی را کاهش می‌دهد، خرید افزایش می‌دهد و پیش‌فاکتور بدون اثر موجودی است." Style="{StaticResource SectionHint}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,12,0,0">
                            <TextBox x:Name="InvoicesSearchBox" Tag="invoices" Width="225" Height="34" Padding="8,4" ToolTip="جست‌وجو در شماره، طرف حساب، شرح و وضعیت" TextChanged="GridSearch_TextChanged" Margin="0,0,8,8"/>
                            <ComboBox x:Name="InvoicesPageSize" Tag="invoices" Width="118" Height="34" SelectedIndex="0" SelectionChanged="GridPageSize_SelectionChanged" Margin="0,0,8,8">
                                <ComboBoxItem Content="۱۰۰ ردیف" Tag="100"/><ComboBoxItem Content="۲۵۰ ردیف" Tag="250"/><ComboBoxItem Content="۵۰۰ ردیف" Tag="500"/>
                            </ComboBox>
                            <Button x:Name="InvoicesPreviousPage" Tag="invoices" Content="قبلی" Click="GridPreviousPage_Click" IsEnabled="False" Margin="0,0,4,8"/>
                            <TextBlock x:Name="InvoicesPageInfo" Text="صفحه ۱ از ۱" VerticalAlignment="Center" Margin="4,0,8,8"/>
                            <Button x:Name="InvoicesNextPage" Tag="invoices" Content="بعدی" Click="GridNextPage_Click" IsEnabled="False" Margin="0,0,12,8"/>
                            <Button Content="صدور سند جدید" Click="AddInvoice_Click" Background="#0F766E" Foreground="White" Margin="0,0,8,8"/>
                            <Button Content="ویرایش پیش‌فاکتور انتخابی" Click="EditInvoice_Click" Margin="0,0,8,8"/>
                            <Button Content="تبدیل پیش‌فاکتور به فروش" Click="ConvertProformaToSale_Click" Margin="0,0,8,8"/>
                            <Button Content="ثبت دریافت/پرداخت" Click="AddPayment_Click" Margin="0,0,8,8"/>
                            <Button Content="لغو سند انتخابی" Click="CancelInvoice_Click" Margin="0,0,8,8"/>
                            <Button Content="پیش‌نمایش سند انتخابی" Click="PreviewInvoice_Click" Margin="0,0,8,8"/>
                            <Button Content="چاپ سند انتخابی" Click="PrintInvoice_Click" Margin="0,0,8,8"/>
                            <Button Content="خروجی CSV کامل" Click="ExportInvoices_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="InvoicesGrid" Grid.Row="1" MouseDoubleClick="InvoicesGrid_MouseDoubleClick"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نوع سند" Binding="{Binding TypeLabel}" Width="115"/>
                            <DataGridTextColumn Header="شماره سند" Binding="{Binding DisplayNumber}" Width="130"/>
                            <DataGridTextColumn Header="کد پیگیری" Binding="{Binding TrackingCode}" Width="190"/>
                            <DataGridTextColumn Header="طرف حساب" Binding="{Binding CustomerName}" Width="180"/>
                            <DataGridTextColumn Header="شرح" Binding="{Binding Description}" Width="200"/>
                            <DataGridTextColumn Header="جمع کالاها" Binding="{Binding Subtotal, StringFormat={}{0:N2}}" Width="130"/>
                            <DataGridTextColumn Header="تخفیف" Binding="{Binding Discount, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="مالیات" Binding="{Binding TaxAmount, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="مبلغ نهایی" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="135"/>
