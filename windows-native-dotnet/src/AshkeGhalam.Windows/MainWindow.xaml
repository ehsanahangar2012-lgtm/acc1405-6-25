                                    <StackPanel Grid.ColumnSpan="2"><TextBlock Text="نشانی API تأییدشده (در حالت فعلی فقط ذخیره می‌شود)" Margin="0,0,0,5"/><TextBox x:Name="MoadianApiBaseUrl" MinHeight="34" Padding="8" FlowDirection="LeftToRight"/></StackPanel>
                                </UniformGrid>
                                <CheckBox x:Name="MoadianIsConfigured" Content="پروفایل مؤدی توسط مدیر سیستم بررسی شده است" Margin="0,12,0,8"/>
