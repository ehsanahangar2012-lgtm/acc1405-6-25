<Window x:Class="AshkeGhalam.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="حسابداری اشک قلم — نسخه بومی ویندوز"
        Width="1360" Height="880" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#F4F7FB" Foreground="#0F172A" FlowDirection="RightToLeft"
        FontFamily="pack://application:,,,/Assets/Fonts/#Vazirmatn"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="76" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/Fonts/#Vazirmatn"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#0F766E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/Fonts/#Vazirmatn"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/Fonts/#Vazirmatn"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="IsTextSearchCaseSensitive" Value="False"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCFBF1"/>
                    <Setter Property="Foreground" Value="#134E4A"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0FDFA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="NumericCellTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MinColumnWidth" Value="52"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHint">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="NavButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#334155"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#0F766E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#14B8A6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavSectionLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="7,15,7,5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border x:Name="WindowHeader" Grid.Row="0" Background="#0F172A" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="24,0" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="اشک قلم" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="CurrentModuleText" Text="پیشخوان • نسخهٔ بومی در کنار نسخهٔ اصلی" Foreground="#CBD5E1" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border VerticalAlignment="Center" Background="#1F2937" BorderBrush="#475569" BorderThickness="1" CornerRadius="18" Padding="12,7" Margin="0,0,10,0">
                        <TextBlock x:Name="StorageStatus" Text="در حال بارگذاری..." Foreground="#E2E8F0" FontSize="12"/>
                    </Border>
                    <Button x:Name="WindowMinimizeButton" Content="—" Width="34" Height="32" Padding="0" Margin="0,0,5,0" Background="#1F2937" Foreground="#E2E8F0" BorderBrush="#475569" BorderThickness="1" ToolTip="کوچک‌کردن پنجره" Click="WindowMinimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="WindowMaximizeButton" Content="□" Width="34" Height="32" Padding="0" Margin="0,0,5,0" Background="#1F2937" Foreground="#E2E8F0" BorderBrush="#475569" BorderThickness="1" ToolTip="تمام‌صفحه / بازگردانی" Click="WindowMaximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="×" Width="34" Height="32" Padding="0" Margin="0" Background="#991B1B" Foreground="#FFFFFF" BorderBrush="#B91C1C" BorderThickness="1" ToolTip="بستن برنامه" Click="WindowClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" FlowDirection="RightToLeft">
                <TabControl x:Name="MainTabs" SelectedIndex="0" FlowDirection="RightToLeft" Margin="0,0,14,0" Padding="0" SelectionChanged="MainTabs_SelectionChanged">
                    <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ControlTemplate>
                    </TabControl.Template>
            <TabItem Header="نمای کلی">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="مدیریت مالی اشک قلم" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="اطلاعات، اسناد و گردش مالی کسب‌وکار در یک نمای یکپارچه" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="نسخهٔ بومی ویندوز  •  ذخیره‌سازی محلی رمزگذاری‌شده" FontSize="11" FontWeight="SemiBold" Foreground="#99F6E4" Margin="0,10,0,0"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="290">
                                    <Button Content="＋ فاکتور جدید" Click="AddInvoice_Click" Background="#0F766E" Foreground="#FFFFFF" MinWidth="132" MinHeight="42" Margin="0,0,8,8"/>
                                    <Button Content="＋ ثبت دریافت" Click="AddReceipt_Click" Background="#1F2937" Foreground="#F8FAFC" BorderBrush="#475569" MinWidth="132" MinHeight="42" Margin="0,0,0,8"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="شاخص‌های کلیدی" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="خلاصهٔ اطلاعات ذخیره‌شده در همین رایانه" Style="{StaticResource SectionHint}"/>
                        <UniformGrid Columns="3" Margin="0,14,0,12">
                            <Border Background="#ECFDF5" CornerRadius="14" Padding="16" Margin="0,0,10,10" BorderBrush="#A7F3D0" BorderThickness="1">
                                <StackPanel><TextBlock Text="مشتریان" Foreground="#475569" FontWeight="SemiBold"/><TextBlock x:Name="CustomerCount" Text="۰" FontSize="27" FontWeight="Bold" Foreground="#047857" Margin="0,10,0,0"/></StackPanel>
                            </Border>
                            <Border Background="#EFF6FF" CornerRadius="14" Padding="16" Margin="0,0,10,10" BorderBrush="#BFDBFE" BorderThickness="1">
                                <StackPanel><TextBlock Text="کالاها" Foreground="#475569" FontWeight="SemiBold"/><TextBlock x:Name="ProductCount" Text="۰" FontSize="27" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,10,0,0"/></StackPanel>
                            </Border>
                            <Border Background="#F5F3FF" CornerRadius="14" Padding="16" Margin="0,0,10,10" BorderBrush="#DDD6FE" BorderThickness="1">
                                <StackPanel><TextBlock Text="اسناد صادرشده" Foreground="#475569" FontWeight="SemiBold"/><TextBlock x:Name="InvoiceCount" Text="۰" FontSize="27" FontWeight="Bold" Foreground="#6D28D9" Margin="0,10,0,0"/></StackPanel>
                            </Border>
                            <Border Background="#F0FDFA" CornerRadius="14" Padding="16" Margin="0,0,10,10" BorderBrush="#99F6E4" BorderThickness="1">
                                <StackPanel><TextBlock Text="ارزش فروش" Foreground="#475569" FontWeight="SemiBold"/><TextBlock x:Name="SalesTotal" Text="۰" FontSize="22" FontWeight="Bold" Foreground="#0F766E" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Background="#FFF7ED" CornerRadius="14" Padding="16" Margin="0,0,10,10" BorderBrush="#FED7AA" BorderThickness="1">
                                <StackPanel><TextBlock Text="ارزش خرید" Foreground="#475569" FontWeight="SemiBold"/><TextBlock x:Name="PurchasesTotal" Text="۰" FontSize="22" FontWeight="Bold" Foreground="#9A3412" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="وضعیت مالی" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <UniformGrid Columns="4" Margin="0,14,0,0">
                                    <StackPanel><TextBlock Text="دریافت ثبت‌شده" Foreground="#64748B"/><TextBlock x:Name="PaymentsTotal" Text="۰" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="مطالبات فروش" Foreground="#64748B"/><TextBlock x:Name="ReceivablesTotal" Text="۰" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="پرداختنی خرید" Foreground="#64748B"/><TextBlock x:Name="PayablesTotal" Text="۰" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="هزینه‌ها" Foreground="#64748B"/><TextBlock x:Name="ExpensesTotal" Text="۰" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="عملیات سریع" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="ثبت اطلاعات پایه و انجام کارهای پرتکرار، بدون جست‌وجو در منوها" Style="{StaticResource SectionHint}" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="＋ ثبت سریع شخص / مشتری" Click="AddCustomer_Click" Background="#0F766E" Foreground="White" Margin="0,0,8,8"/>
                                    <Button Content="＋ ثبت تأمین‌کننده" Click="AddSupplier_Click" Margin="0,0,8,8"/>
                                    <Button Content="＋ ثبت سریع کالا" Click="AddProduct_Click" Background="#0F766E" Foreground="White" Margin="0,0,8,8"/>
                                    <Button Content="＋ فاکتور جدید" Click="AddInvoice_Click" Background="#0F766E" Foreground="White" Margin="0,0,8,8"/>
                                    <Button Content="ثبت دریافت از مشتری" Click="AddReceipt_Click" Margin="0,0,8,8"/>
                                    <Button Content="پرداخت به تأمین‌کننده" Click="AddSupplierPayment_Click" Margin="0,0,8,8"/>
                                    <Button Content="ثبت دریافت / پرداخت (همه)" Click="AddPayment_Click" Margin="0,0,8,8"/>
                                    <Button Content="ثبت هزینه" Click="AddExpense_Click" Margin="0,0,8,8"/>
                                    <Button Content="ورود موجودی" Click="AddStock_Click" Margin="0,0,8,8"/>
                                    <Button Content="حواله انبار" Click="AddVoucher_Click" Margin="0,0,8,8"/>
                                    <Button Content="پیش‌نمایش فاکتور انتخابی" Click="PreviewInvoice_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="آخرین اسناد" FontSize="18" FontWeight="Bold" Margin="0,20,0,0"/>
                        <DataGrid x:Name="RecentInvoicesGrid" Height="235">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="نوع" Binding="{Binding TypeLabel}" Width="1.05*"/>
                                <DataGridTextColumn Header="شماره سند" Binding="{Binding DisplayNumber}" Width="1.2*"/>
                                <DataGridTextColumn Header="طرف حساب" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="1.5*"/>
                                <DataGridTextColumn Header="مبلغ کل" Binding="{Binding Total, StringFormat={}{0:#,##0.##}}" ElementStyle="{StaticResource NumericCellTextStyle}" Width="1.5*"/>
                                <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="1.2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="مشتریان">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="مدیریت اشخاص" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="پرونده شامل کد، نقش، دسته‌بندی و اطلاعات تماس است. برای گردش بدهکار/بستانکار، فاکتورها، دریافت/پرداخت و چک‌های مستقل، «کاردکس مالی شخص انتخابی» را باز کنید؛ هزینه‌های مستقیم شخص و برخی گردش‌های قدیمی هنوز نیازمند تطبیق بیشترند." Style="{StaticResource SectionHint}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,14,0,0">
                            <TextBox x:Name="CustomersSearchBox" Tag="customers" Width="225" Height="34" Padding="8,4" ToolTip="جست‌وجو در کد، نام، تلفن، ایمیل و نشانی" TextChanged="GridSearch_TextChanged" Margin="0,0,8,8"/>
                            <ComboBox x:Name="CustomersPageSize" Tag="customers" Width="118" Height="34" SelectedIndex="0" SelectionChanged="GridPageSize_SelectionChanged" Margin="0,0,8,8">
                                <ComboBoxItem Content="۱۰۰ ردیف" Tag="100"/><ComboBoxItem Content="۲۵۰ ردیف" Tag="250"/><ComboBoxItem Content="۵۰۰ ردیف" Tag="500"/>
                            </ComboBox>
                            <Button x:Name="CustomersPreviousPage" Tag="customers" Content="قبلی" Click="GridPreviousPage_Click" IsEnabled="False" Margin="0,0,4,8"/>
                            <TextBlock x:Name="CustomersPageInfo" Text="صفحه ۱ از ۱" VerticalAlignment="Center" Margin="4,0,8,8"/>
                            <Button x:Name="CustomersNextPage" Tag="customers" Content="بعدی" Click="GridNextPage_Click" IsEnabled="False" Margin="0,0,12,8"/>
                            <Button Content="ثبت شخص جدید" Click="AddCustomer_Click" Background="#0F766E" Foreground="White" Margin="0,0,8,8"/>
                            <Button Content="ثبت تأمین‌کننده" Click="AddSupplier_Click" Margin="0,0,8,8"/>
                            <Button Content="ویرایش شخص انتخابی" Click="EditCustomer_Click" Margin="0,0,8,8"/>
                            <Button Content="حذف شخص انتخابی" Click="DeleteCustomer_Click" Margin="0,0,8,8"/>
                            <Button Content="کاردکس مالی شخص انتخابی" Click="ShowPersonKardex_Click" Background="#0F766E" Foreground="White" Margin="0,0,8,8"/>
                            <Button Content="خروجی CSV کامل پرونده‌ها" Click="ExportCustomers_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="CustomersGrid" Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کد شخص" Binding="{Binding Code}" Width="1.05*"/>
                            <DataGridTextColumn Header="نام / شرکت" Binding="{Binding Name}" Width="2.1*"/>
                            <DataGridTextColumn Header="نقش" Binding="{Binding RoleLabel}" Width="1.55*"/>
                            <DataGridTextColumn Header="دسته‌بندی" Binding="{Binding Category}" Width="1.2*"/>
                            <DataGridTextColumn Header="تلفن" Binding="{Binding Phone}" Width="1.35*"/>
                            <DataGridTextColumn Header="ایمیل" Binding="{Binding Email}" Width="1.9*"/>
                            <DataGridTextColumn Header="شناسه ملی" Binding="{Binding NationalId}" Width="1.3*"/>
                            <DataGridTextColumn Header="نشانی" Binding="{Binding Address}" Width="2.5*"/>
                            <DataGridTextColumn Header="یادداشت" Binding="{Binding Notes}" Width="2.2*"/>
                            <DataGridTextColumn Header="ماندهٔ ذخیره‌شده*" Binding="{Binding Balance, StringFormat={}{0:#,##0.##}}" ElementStyle="{StaticResource NumericCellTextStyle}" Width="1.45*"/>
                            <DataGridTextColumn Header="تاریخ ثبت" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="1.55*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="کالا و انبار">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="کالا و انبار" FontSize="23" FontWeight="Bold"/>
