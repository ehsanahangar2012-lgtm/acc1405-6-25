<Window x:Class="AshkeGhalam.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حسابداری اشک قلم" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0F172A" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="اشک قلم" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="سامانه حسابداری • نسخه بومی ویندوز" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Background="#1E293B" BorderBrush="#334155"
                        BorderThickness="1" CornerRadius="18" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="اتصال سرور هنوز بررسی نشده" Foreground="#E2E8F0" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#111827" CornerRadius="16" Padding="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,16">
                        <TextBlock Text="فضای کاری" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="شرکت اشک قلم" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="#1E293B" CornerRadius="10" Padding="10" Margin="2,14,2,2">
                        <StackPanel>
                            <TextBlock Text="پوستهٔ آزمایشی" Foreground="#FBBF24" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="هیچ دادهٔ حسابداری هنوز بارگذاری نمی‌شود." Foreground="#94A3B8"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="منوی اصلی" Foreground="#64748B" FontSize="11" Margin="12,0,12,8"/>
                        <RadioButton Content="نمای کلی" Tag="dashboard" GroupName="MainNavigation" IsChecked="True"
                                     Style="{StaticResource NavigationRadioButton}" Click="Navigation_Click"/>
                        <RadioButton Content="فاکتورها" Tag="invoices" GroupName="MainNavigation"
                                     Style="{StaticResource NavigationRadioButton}" Click="Navigation_Click"/>
                        <RadioButton Content="مشتریان" Tag="customers" GroupName="MainNavigation"
                                     Style="{StaticResource NavigationRadioButton}" Click="Navigation_Click"/>
                        <RadioButton Content="انبار و کالا" Tag="inventory" GroupName="MainNavigation"
                                     Style="{StaticResource NavigationRadioButton}" Click="Navigation_Click"/>
                        <RadioButton Content="امور مالی" Tag="finance" GroupName="MainNavigation"
                                     Style="{StaticResource NavigationRadioButton}" Click="Navigation_Click"/>
                        <RadioButton Content="گزارش‌ها" Tag="reports" GroupName="MainNavigation"
                                     Style="{StaticResource NavigationRadioButton}" Click="Navigation_Click"/>
                        <RadioButton Content="خدمات ابری" Tag="cloud" GroupName="MainNavigation"
                                     Style="{StaticResource NavigationRadioButton}" Click="Navigation_Click"/>
                        <RadioButton Content="پشتیبان‌گیری" Tag="backup" GroupName="MainNavigation"
                                     Style="{StaticResource NavigationRadioButton}" Click="Navigation_Click"/>
                        <RadioButton Content="تنظیمات" Tag="settings" GroupName="MainNavigation"
                                     Style="{StaticResource NavigationRadioButton}" Click="Navigation_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="18,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="4,4,4,20">
                    <TextBlock x:Name="PageTitle" Text="نمای کلی" Foreground="{StaticResource PrimaryText}" FontSize="27" FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitle" Text="پوستهٔ اولیهٔ رابط بومی اشک قلم" Foreground="{StaticResource MutedText}" FontSize="13" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="نمونهٔ اولیه — برای استفادهٔ حسابداری آماده نیست" Foreground="#92400E" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="ورود، لایسنس، پایگاه داده، همگام‌سازی و عملیات مالی هنوز متصل نشده‌اند. تا زمان تکمیل آزمون‌ها، نسخه‌های فعلی را حفظ کنید."
                                   Foreground="#92400E" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Background="{StaticResource SurfaceBackground}" CornerRadius="16" Padding="28"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
                        <Border Width="76" Height="76" CornerRadius="18" Background="#CCFBF1" Padding="18">
                            <TextBlock Text="ا" Foreground="#0F766E" FontSize="33" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="معماری بومی در حال آماده‌سازی است" Foreground="#0F172A" FontSize="21"
                                   FontWeight="Bold" TextAlignment="Center" Margin="0,22,0,0"/>
                        <TextBlock x:Name="FeatureDescription" Text="این پنجره با WPF ساخته شده است؛ رابط وب یا WebView در آن استفاده نمی‌شود."
                                   Foreground="#64748B" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock Text="نسخه 16.55.0 • وضعیت: پوسته و زیرساخت اولیه" Foreground="#0F766E"
                                   FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,22,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
